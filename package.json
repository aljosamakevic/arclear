{
  "name": "arclear",
  "version": "3.0.0",
  "description": "Permissionless multilateral obligation-netting clearinghouse primitive for any ERC-20 on Arc — 100 micropayments, 1 settlement.",
  "keywords": [
    "arc",
    "clearing",
    "netting",
    "clearinghouse",
    "settlement",
    "eip-712",
    "usdc",
    "eurc",
    "pvp",
    "viem",
    "erc20",
    "stablecoin"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/aljosamakevic/arclear.git"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "docs/CONCEPTS.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build && npm test",
    "test": "vitest run",
    "test:contracts": "cd contracts && forge test -vvv",
    "fixture": "tsx test/genFixture.ts",
    "e2e:anvil": "tsx demo/e2e.ts --anvil",
    "e2e:testnet": "tsx demo/e2e.ts",
    "demo": "tsx demo/server.ts",
    "report": "tsx demo/report.ts",
    "sweep": "tsx demo/sweep.ts",
    "sweep:threshold": "tsx demo/thresholdSweep.ts",
    "sweep:margin": "tsx demo/marginSweep.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "fast-check": "^3.22.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
