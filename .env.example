# RPC for Arc Testnet (chain id 5042002).
# Public default below; swap in your own provider endpoint if you have one.
ARC_RPC_URL=https://rpc.testnet.arc.network

# Deployer private key (0x-prefixed). Needs native USDC for gas AND ERC-20 USDC
# for collateral — both from https://faucet.circle.com/ (select Arc Testnet).
DEPLOYER_PK=

# Mnemonic used to derive the 5 demo agent accounts (any BIP-39 phrase).
AGENT_MNEMONIC=

# v1 ClearingHub addresses — UNUSED BY THE DEMO. Nothing in src/, demo/ or
# contracts/ reads these; they are a record of the still-live Arclear Net v1
# deployment (contracts/script/Deploy.s.sol). Leave blank unless you want one.
HUB_USDC=
HUB_EURC=

# V2 hubs (threshold consent + merkle manifests + redemption) — REQUIRED by
# the demo/e2e testnet path. Deploy with contracts/script/DeployV2.s.sol, once
# per token (see README "Arc Testnet").
HUB_V2_USDC=
HUB_V2_EURC=
# PvPRouter bound to the two V2 hubs above (cross-currency atomic settlement)
# — also REQUIRED. Deploy with contracts/script/DeployPvPRouter.s.sol.
PVP_ROUTER=

# Deploy block of the V2 USDC hub, in decimal (53404331 = 0x32ee2ab for the
# current hub — from contracts/broadcast/DeployV2.s.sol/5042002). Event-scan
# floor: the public Arc RPC prunes old history and rejects eth_getLogs from
# genesis. Unset → the demo falls back to latest − 1,000,000.
HUB_V2_DEPLOY_BLOCK=53404331
