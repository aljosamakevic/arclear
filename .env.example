# RPC for Arc Testnet (chain id 5042002).
# Public default below; swap in your own provider endpoint if you have one.
ARC_RPC_URL=https://rpc.testnet.arc.network

# Deployer private key (0x-prefixed). Needs native USDC for gas AND ERC-20 USDC
# for collateral — both from https://faucet.circle.com/ (select Arc Testnet).
DEPLOYER_PK=

# Mnemonic used to derive the 5 demo agent accounts (any BIP-39 phrase).
AGENT_MNEMONIC=

# v1 ClearingHub addresses — UNUSED BY THE DEMO. Nothing in src/, demo/ or
# contracts/ reads these; they are a record of the still-live Arclear Net v1
# deployment (contracts/script/Deploy.s.sol). Leave blank unless you want one.
HUB_USDC=
HUB_EURC=

# V2 hubs — SUPERSEDED, UNUSED BY THE DEMO. Kept only as a record of the still
# -deployed V2 surface. V2's redemption is defeatable (audit CR-01 manifest
# poisoning + CR-02 root-ring flush), which is why V3 exists; nothing in src/
# or demo/ reads these any more.
HUB_V2_USDC=
HUB_V2_EURC=
PVP_ROUTER=

# V3 hubs (party-bound manifests + O(1) proofless redemption) — REQUIRED by
# the demo/e2e testnet path. Deploy with contracts/script/DeployV3.s.sol, once
# per token (see README "Arc Testnet").
HUB_V3_USDC=
HUB_V3_EURC=
# PvPRouterV3 bound to the two V3 hubs above (cross-currency atomic
# settlement) — also REQUIRED. Deploy with
# contracts/script/DeployPvPRouterV3.s.sol. Its EIP-712 domain is
# ("ArclearPvPRouterV3", "1"), so V2-router consents can never replay here.
PVP_ROUTER_V3=

# Deploy block of the V3 USDC hub, in decimal. Event-scan floor: the public Arc
# RPC prunes old history and rejects eth_getLogs from genesis. Read it from
# contracts/broadcast/DeployV3.s.sol/5042002 after deploying. Unset → the demo
# falls back to latest − 1,000,000.
HUB_V3_DEPLOY_BLOCK=
